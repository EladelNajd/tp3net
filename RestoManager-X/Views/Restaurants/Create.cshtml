@model RestoManager_X.Models.RestosModel.Restaurant

<form asp-action="Create" method="post">
    <div class="form-group">
        <label asp-for="NomResto"></label>
        <input asp-for="NomResto" class="form-control" />
        <span asp-validation-for="NomResto" class="text-danger"></span>
    </div>

    <div class="form-group">
        <label asp-for="Specialite"></label>
        <input asp-for="Specialite" class="form-control" value="tunnisienne" />
        <span asp-validation-for="Specialite" class="text-danger"></span>
    </div>

    <div class="form-group">
        <label asp-for="Ville"></label>
        <input asp-for="Ville" class="form-control" />
        <span asp-validation-for="Ville" class="text-danger"></span>
    </div>

    <div class="form-group">
        <label asp-for="Tel"></label>
        <input asp-for="Tel" class="form-control" />
        <span asp-validation-for="Tel" class="text-danger"></span>
    </div>

    <div class="form-group">
        <label asp-for="Numprop"></label>
        <input asp-for="Numprop" class="form-control" />
        <span asp-validation-for="Numprop" class="text-danger"></span>
    </div>

    <button type="submit" class="btn btn-primary">Créer</button>
</form>
