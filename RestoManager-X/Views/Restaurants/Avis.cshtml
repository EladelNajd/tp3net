@model RestoManager_X.Models.RestosModel.Restaurant

@{
    ViewData["Title"] = "Avis pour " + Model.NomResto;
}

<h2>@ViewData["Title"]</h2>

@if (Model.LesAvis != null && Model.LesAvis.Any())
{
    <table class="table table-striped">
        <thead>
            <tr>
                <th>Nom</th>
                <th>Note</th>
                <th>Commentaire</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var avis in Model.LesAvis)
            {
                <tr>
                    <td>@avis.NomPersonne</td>
                    <td>@avis.Note</td>
                    <td>@avis.Commentaire</td>
                </tr>
            }
        </tbody>
    </table>
}
else
{
    <div class="alert alert-info">Aucun avis trouvé pour ce restaurant.</div>
}
